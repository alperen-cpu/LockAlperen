{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The only window. App commands only: no core, file-system, shell or dialog permission for the WebView.",
  "windows": ["main"],
  "permissions": [
    "allow-pick-vault-file",
    "allow-unlock",
    "allow-lock",
    "allow-list-entries",
    "allow-copy-field",
    "allow-reveal-password",
    "allow-lock-status",
    "allow-pick-new-vault-path",
    "allow-create-vault",
    "allow-recent-vaults",
    "allow-select-recent",
    "allow-forget-recent",
    "allow-list-groups",
    "allow-entry-form",
    "allow-save-entry",
    "allow-delete-entry",
    "allow-generate-password",
    "allow-totp-code",
    "allow-password-health"
  ]
}
